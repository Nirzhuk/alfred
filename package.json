{
  "name": "alfred",
  "private": true,
  "version": "1.2.1",
  "description": "Alfred — local multi-agent workflow automations",
  "license": "GPL-3.0-or-later",
  "author": "nirzhuk",
  "packageManager": "bun@1.3.8",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/guard-desktop-tauri.mjs dev",
    "build": "node ./scripts/guard-desktop-tauri.mjs build",
    "build:dev": "node ./scripts/guard-desktop-tauri.mjs build --config src-tauri/tauri.dev.conf.json",
    "dev:frontend": "vite",
    "build:frontend": "tsc && vite build",
    "test": "bun test",
    "test:frontend": "bun test",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "bun run test:frontend && bun run build:frontend && bun run test:rust",
    "verify:polar-sandbox": "bun run ./scripts/polar/verify-sandbox.ts",
    "verify:release-hygiene": "bun run ./scripts/release/verify-release-hygiene.ts",
    "prepare:managed-runtimes": "bun run ./scripts/managed-runtimes/prepare.ts",
    "verify:managed-runtimes": "bun run ./scripts/managed-runtimes/verify.ts",
    "test:managed-runtimes": "bun test scripts/managed-runtimes",
    "tauri": "node ./scripts/guard-desktop-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3",
    "@tauri-apps/plugin-updater": "~2.12",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}

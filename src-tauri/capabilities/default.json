{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Alfred window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:app:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "x-apple.systempreferences:*" },
        { "url": "https://github.com/*" },
        { "url": "https://accounts.google.com/*" },
        { "url": "https://login.microsoftonline.com/*" },
        { "url": "https://chatgpt.com/*" },
        { "url": "https://auth.openai.com/*" },
        { "url": "https://claude.ai/*" },
        { "url": "https://www.claude.ai/*" },
        { "url": "https://console.anthropic.com/*" },
        { "url": "https://cursor.com/*" },
        { "url": "https://www.cursor.com/*" },
        { "url": "https://authenticator.cursor.sh/*" },
        { "url": "https://www.notion.so/profile/integrations/internal" },
        { "url": "https://t.me/*" },
        { "url": "https://buy.polar.sh/polar_cl_*" },
        { "url": "https://polar.sh/*/portal" },
        {
          "url": "https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_*/redirect"
        },
        { "url": "https://sandbox.polar.sh/*/portal" }
      ]
    },
    "window-state:default",
    "notification:default",
    "dialog:default",
    "deep-link:default"
  ]
}

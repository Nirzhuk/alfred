# Publisher-owned GitHub App (device flow, no client secret).
# Create at https://github.com/settings/apps/new, enable Device Flow.
ALFRED_GITHUB_APP_CLIENT_ID=
ALFRED_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new

# Optional: publisher-owned Gmail OAuth client.
ALFRED_GMAIL_CLIENT_ID=
ALFRED_GMAIL_OAUTH_PORT=

# Polar commerce. Every value here is PUBLIC; never add a Polar access token,
# webhook secret, product ID, price ID, or license key.
# ALFRED_* is baked into the Rust binary by src-tauri/build.rs.
# VITE_* is baked into the frontend bundle by Vite.
# Leave every value blank to ship an unconfigured build; filling only some of
# them is reported as an incomplete configuration, not ignored.
# ALFRED_POLAR_ENVIRONMENT (sandbox|production) also picks which public-link
# shapes the app will open; the two sets never overlap. See
# src/features/licensing/public-link-rules.ts and docs/polar-operator-handoff.md.
#   production  checkout https://buy.polar.sh/polar_cl_...
#               portal   https://polar.sh/<org-slug>/portal
#   sandbox     checkout https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_.../redirect
#               portal   https://sandbox.polar.sh/<org-slug>/portal
ALFRED_POLAR_ENVIRONMENT=
ALFRED_POLAR_ORGANIZATION_ID=
# Two products, two License Keys benefits: Alfred License (one named user) and
# Alfred Teams (one-time per claimed seat). Both keys carry a one-year expiry.
ALFRED_POLAR_INDIVIDUAL_BENEFIT_ID=
ALFRED_POLAR_TEAMS_BENEFIT_ID=
# Desktop only: Teams is sold on the marketing website, so the app has no Teams
# checkout entry point.
VITE_POLAR_INDIVIDUAL_CHECKOUT_URL=
VITE_POLAR_CUSTOMER_PORTAL_URL=

# Release date of THIS build, ISO YYYY-MM-DD, set by the release workflow — not
# by hand and not from the build machine's clock. A build is inside a
# customer's update window when ALFRED_RELEASE_DATE <= their license deadline.
# Unset means a source build: it never locks anything.
ALFRED_RELEASE_DATE=

# Self-compile opt-out: set to 1 to disable all license gating without Polar.
# Self-compiled builds with blank Polar values already never lock; this flag
# additionally forces unlocked even when Polar values are present (for example
# a local checkout reusing a publisher .env). Official builds leave it blank.
ALFRED_DISABLE_LICENSE_GATING=
